cesito para inscribirme"],["es","hay cupos limitados"],["es","todavía hay lugares"],["es","quedan vacantes"],["es","cuánto cuesta el curso"],["es","cuál es el precio del curso"],["es","qué valor tiene el curso"],["es","aceptan tarjeta de crédito"],["es","se puede pagar con débito"],["es","qué medios de pago aceptan"],["es","hay descuentos"],["es","tienen promociones"],["es","dan becas"],["es","dan certificado"],["es","entregan diploma"],["es","tiene certificación oficial"],["es","qué necesito para aprobar"],["es","cómo se aprueba el curso"],["es","dónde están ubicados"],["es","cuál es la dirección"],["es","cómo llego"],["es","cómo los contacto"],["es","tienen whatsapp"],["es","cuál es el número"],["es","tienen redes sociales"],["es","dónde los sigo"],["es","cuál es su instagram"],["es","qué temas se ven"],["es","qué se aprende"],["es","qué contenido tiene el curso"],["es","necesito conocimientos previos"],["es","tengo que saber algo antes"],["es","hay salida laboral"],["es","puedo trabajar después del curso"],["es","ofrecen bolsa de trabajo"],["es","ayudan a conseguir trabajo"]]},"ner":{"settings":{"tag":"ner","entityPreffix":"%","entitySuffix":"%"},"rules":{}},"nlgManager":{"settings":{"tag":"nlg-manager"},"responses":{"es":{"saludo":[{"answer":"¡Hola! 👋 Soy el asistente virtual de nuestra institución de refrigeración integral. ¿En qué puedo ayudarte?"}],"info.cursos":[{"answer":"Ofrecemos cursos de Refrigeración Integral Básica, Avanzada, Aires Acondicionados Split, y Cámaras Frigoríficas. ❄️"}],"info.definicion":[{"answer":"La refrigeración integral abarca el mantenimiento, instalación y reparación de sistemas de refrigeración, aire acondicionado y cámaras frigoríficas."}],"info.modalidad":[{"answer":"Actualmente ofrecemos cursos presenciales y también modalidad online con clases en vivo 🎥."}],"info.duracion":[{"answer":"Los cursos básicos duran aproximadamente 2 meses y los avanzados 3 meses."}],"info.horarios":[{"answer":"Tenemos turnos por la mañana, tarde y noche, de lunes a viernes. También hay opciones los sábados."}],"inscripcion.proceso":[{"answer":"Podés inscribirte completando el formulario en nuestra web o acercándote a nuestra sede con tu DNI."}],"inscripcion.cupos":[{"answer":"Sí, los cupos son limitados, te recomendamos reservar tu lugar cuanto antes ✅."}],"pago.precio":[{"answer":"El curso básico tiene un costo de $45.000 por mes y el avanzado $60.000. Podés abonar por transferencia o en efectivo."}],"pago.metodos":[{"answer":"Aceptamos pagos con tarjeta, transferencia bancaria, Mercado Pago y efectivo 💳."}],"pago.descuentos":[{"answer":"Sí, ofrecemos descuentos por pago anticipado y promociones especiales para grupos o empresas."}],"certificacion.info":[{"answer":"Sí, entregamos certificado avalado por la institución al finalizar el curso con aprobación."}],"certificacion.requisitos":[{"answer":"Para aprobar, necesitás cumplir con el 80% de asistencia y aprobar las evaluaciones prácticas y teóricas."}],"info.ubicacion":[{"answer":"Nuestra sede está en Av. San Martín 1234, Resistencia, Chaco 📍."}],"info.contacto":[{"answer":"Podés escribirnos por WhatsApp al +54 9 362 123 4567 📱 o enviarnos un mail a info@refrigeracionintegral.com."}],"info.redes":[{"answer":"Sí, estamos en Instagram como @refrigeracion.integral y en Facebook como Refrigeración Integral Oficial 🌐."}],"info.temas":[{"answer":"Aprenderás sobre gases refrigerantes, electricidad aplicada, instalación de split, mantenimiento preventivo y diagnóstico de fallas."}],"info.requisitos":[{"answer":"No, el curso básico no requiere experiencia previa. Empezamos desde cero y con práctica guiada 👨‍🔧."}],"info.salida":[{"answer":"Sí, nuestros egresados suelen trabajar en servicios técnicos, empresas de climatización o emprendimientos propios."}],"info.bolsa":[{"answer":"Sí, contamos con una bolsa laboral donde conectamos egresados con empresas del rubro."}]}}},"actionManager":{"settings":{"tag":"action-manager"},"actions":{}},"slotManager":{}}